<?xml version="1.0" encoding="utf-8"?>
<!--
  §10. Nothing is backed up, cloud or local.

  allowBackup="false" already covers this, and the explicit exclusions are here
  because the failure mode is silent: a device-to-device transfer that carried
  cue.db would move a stranger's private messages onto hardware she has never
  heard of. She never consented to any of this, and the database has no
  counterpart anywhere to restore from either.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
